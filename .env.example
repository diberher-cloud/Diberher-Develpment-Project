# Backend
# Nota (Docker Compose): en variables SIN valor no escriba el comentario en la misma línea; Compose
# lo tomaría como valor. Los comentarios en línea solo son seguros tras un valor no vacío.
ENTORNO=desarrollo                 # desarrollo | test | produccion
DATABASE_URL=postgresql+psycopg://outbound:outbound@db:5432/outbound
JWT_SECRETO=cambia-esto-por-un-secreto-de-32-caracteres-o-mas
JWT_EXPIRACION_MINUTOS=480
BCRYPT_COSTE=12
CORS_ORIGENES=http://localhost:5173
IMPORTACION_MAX_BYTES=10485760
IMPORTACION_MAX_FILAS=50000
EXCLUSIONES_MAX_FILAS=200000
# Opcional: contraseña para `crear-admin` no interactivo
ADMIN_PASSWORD=
# Empresa
EMPRESA_NOMBRE=Mi Empresa S.A.S.
# Telefonía (2A)
TELEFONIA_PROVEEDOR=falso                 # falso | twilio
PUBLIC_BASE_URL=http://localhost:8000     # URL pública EXACTA con la que Twilio llama (https; túnel en desarrollo con Twilio real); sin barra final
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=token-falso-solo-desarrollo
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# +57..., caller ID del número Twilio
TWILIO_NUMERO_SALIENTE=
TELEFONIA_TOKEN_TTL_SEGUNDOS=3600
TELEFONIA_GRABAR=true
TELEFONIA_AVISO_GRABACION=Le informamos que esta llamada será grabada y monitoreada con fines de calidad y seguridad.
TELEFONIA_IDIOMA_VOZ=es-MX
TELEFONIA_MENSAJE_BLOQUEO=No es posible realizar la llamada en este momento.
# Consola
CONSOLA_RESERVA_MINUTOS=15
CONSOLA_DESCONEXION_SEGUNDOS=60
PROMESA_MAX_DIAS=60
# Importación
IMPORTACION_MAX_BYTES_DESCOMPRIMIDO=104857600
# Tiempo real
WS_REVALIDAR_SEGUNDOS=60                  # revalida usuario activo/rol de cada WebSocket
BUS_EVENTOS=auto                          # auto (postgres si DATABASE_URL es PostgreSQL; si no, memoria) | memoria | postgres
# WhatsApp (2B)
WHATSAPP_PROVEEDOR=falso                  # falso | twilio
WHATSAPP_NUMERO_EMPRESA=+573000000001     # E.164 del sender de WhatsApp (obligatorio y real con twilio)
WHATSAPP_MARGEN_VENTANA_SEGUNDOS=60
WHATSAPP_MEDIA_MAX_BYTES=16777216
WHATSAPP_DIAS_RESOLUCION_PLANTILLA=30
WHATSAPP_PAYLOAD_BAJA=BAJA
# Proxy de medios: descargas simultáneas máximas (excederlas da 429) y duración total máxima
WHATSAPP_MEDIA_CONCURRENCIA=4
WHATSAPP_MEDIA_DURACION_SEGUNDOS=30
# Hosts (https) a los que se sigue una redirección al descargar medios; api.twilio.com siempre
WHATSAPP_HOSTS_MEDIOS=media.twiliocdn.com
# Vacío = lista por defecto; frases separadas por |
WHATSAPP_FRASES_OPT_OUT=
WHATSAPP_FRASES_OPT_OUT_TODOS=
WHATSAPP_MENSAJE_OPT_OUT=Hemos registrado su solicitud. No le enviaremos más mensajes por WhatsApp.
WHATSAPP_MENSAJE_OPT_OUT_TODOS=Hemos registrado su solicitud. No volveremos a contactarle por ningún medio.
WHATSAPP_MENSAJE_ESPERA=Gracias por escribirnos. Un asesor le responderá en nuestro horario de atención.
WHATSAPP_MENSAJE_FUERA_DE_FRANJA=Recibimos su mensaje. Le responderemos dentro de nuestro horario de atención.
CONVERSACION_INACTIVIDAD_HORAS=24
ATENCION_MAX_CONVERSACIONES_AGENTE=5
# Worker (2B)
WORKER_INTERVALO_SEGUNDOS=1
WORKER_LOTE=10
WORKER_BLOQUEO_SEGUNDOS=300
# Purga: eventos de estado sin mensaje enlazado se borran tras N días
PURGA_EVENTOS_HUERFANOS_DIAS=7
# Agente IA (2C)
IA_PROVEEDOR=falso                         # falso | anthropic
ANTHROPIC_API_KEY=                         # secreto; obligatorio con IA_PROVEEDOR=anthropic (nunca ANTHROPIC_LOG)
IA_HABILITADA=true                         # kill switch por entorno
IA_MODELOS_PERMITIDOS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
IA_MODELOS_SIN_SYSTEM_INTERMEDIO=          # modelos a los que los mensajes system se envían como <aviso_servidor>
IA_MODELO_POR_DEFECTO=claude-opus-5-5
IA_ESFUERZO_POR_DEFECTO=medium
IA_MAX_TOKENS=8000
IA_MAX_ITERACIONES=8
IA_TIMEOUT_SEGUNDOS=45
IA_TURNO_MAX_SEGUNDOS=240                  # < WORKER_BLOQUEO_SEGUNDOS
IA_REINTENTO_ARRIENDO_SEGUNDOS=2
IA_FALLBACK_RECHAZO=false
IA_CACHE_TTL=5m                            # 5m | 1h
IA_DEBOUNCE_SEGUNDOS=3
IA_DEBOUNCE_MAX_SEGUNDOS=10
IA_MAX_CARACTERES_ENTRADA=2000
IA_MAX_MENSAJES_TURNO=20
IA_MAX_CARACTERES_SALIDA=1000
IA_PRECIOS_JSON=                           # vacío = valores por defecto (USD por millón de tokens)
IA_AVISO_ASISTENTE=Le atiende el asistente virtual de Mi Empresa S.A.S. Puede pedir hablar con un asesor en cualquier momento.
IA_FRASES_HUMANO=                          # vacío = lista por defecto; separadas por |
IA_PAYLOAD_ASESOR=ASESOR
IA_MENSAJE_TRASPASO=Le comunico con un asesor, que continuará la conversación por este medio.
IA_DOMINIOS_PERMITIDOS=                    # separados por coma; vacío = ninguna URL
IA_TEXTO_RETRACTO=                         # texto legal del derecho de retracto (ventas)
IA_ALERTA_PRESUPUESTO_PCT=80
IA_ERRORES_UMBRAL=5
IA_ERRORES_VENTANA_MINUTOS=10
IA_EXIGIR_EVALUACION_ONLINE=false
IA_UMBRAL_ONLINE_NEGOCIACION=0.90
RETENCION_TRANSCRIPCIONES_DIAS=365         # la usa 2G
# Postgres
POSTGRES_USER=outbound
POSTGRES_PASSWORD=outbound
POSTGRES_DB=outbound
# Frontend
VITE_PROXY_TARGET=http://backend:8000
